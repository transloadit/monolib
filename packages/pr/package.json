{
  "name": "@transloadit/pr",
  "version": "2.0.0",
  "repository": {
    "type": "git",
    "url": "git://github.com/transloadit/monolib.git",
    "directory": "packages/pr"
  },
  "license": "AGPL-3.0-only",
  "main": "dist/pr.js",
  "types": "dist/pr.d.ts",
  "files": [
    "dist",
    "src",
    "!*.test.*"
  ],
  "scripts": {
    "prepack": "tsc --build",
    "test": "tsc --build && node --test --enable-source-maps",
    "test:watch": "node --test --enable-source-maps --watch"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/pr.d.ts",
      "import": "./dist/pr.js"
    },
    "./package.json": "./package.json"
  }
}
