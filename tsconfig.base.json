{
  "compilerOptions": {
    "lib": ["ES2023"],
    "target": "es2022",
    "module": "nodenext",
    "esModuleInterop": true,
    "rewriteRelativeImportExtensions": true,

    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true,
    "sourceMap": true,
    "types": ["node"],

    "declaration": true,
    "composite": true,
    "incremental": true,
    "removeComments": true
  }
}
